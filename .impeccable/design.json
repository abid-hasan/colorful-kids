  "components": [
    {
      "name": "মূল action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "মূল action — বর্তমান UI থেকে নেওয়া দৃশ্যমান ধরন।",
      "html": "<button class=\"ds-primary\">খেলা শুরু <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:15px;font-family:Baloo,Nunito,sans-serif;cursor:pointer;background:var(--purple,#7550ba);color:white;border:0;border-radius:16px;padding:13px 30px;min-height:58px;font-size:19px;font-weight:700;box-shadow:0 6px 15px #7550ba22;transition:background .2s,transform .25s cubic-bezier(.16,1,.3,1)}.ds-primary:hover{background:var(--purple-dark,#5e3b9f);transform:translateY(-2px)}.ds-primary:active{transform:translateY(1px)}.ds-primary:focus-visible{outline:3px solid var(--purple,#7550ba);outline-offset:5px}"
    },
    {
      "name": "আবার শোনা",
      "kind": "button",
      "refersTo": "button-listen",
      "description": "আবার শোনা — বর্তমান UI থেকে নেওয়া দৃশ্যমান ধরন।",
      "html": "<button class=\"ds-listen\">আবার শোনো</button>",
      "css": ".ds-listen{font-family:Baloo,Nunito,sans-serif;cursor:pointer;background:#ece3f8;color:#604094;border:0;border-radius:28px;padding:10px 21px;min-height:52px;font-size:17px;font-weight:700;transition:background .2s}.ds-listen:hover{background:#dfcff3}.ds-listen:focus-visible{outline:3px solid var(--purple,#7550ba);outline-offset:5px}"
    },
    {
      "name": "Activity navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Activity navigation — বর্তমান UI থেকে নেওয়া দৃশ্যমান ধরন।",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">চলো খেলি</button><button>রং শিখি</button></nav>",
      "css": ".ds-nav{display:flex;gap:9px}.ds-nav button{font-family:Baloo,Nunito,sans-serif;cursor:pointer;padding:11px 24px;border:0;border-radius:30px;min-height:48px;background:transparent;color:var(--muted,#716581);font-size:16px}.ds-nav button[aria-current=page]{background:#e5daf5;color:#563589;font-weight:700}.ds-nav button:hover{color:var(--purple-dark,#5e3b9f)}.ds-nav button:focus-visible{outline:3px solid var(--purple,#7550ba);outline-offset:5px}"
    },
    {
      "name": "ভাষা নির্বাচন",
      "kind": "chip",
      "refersTo": "language",
      "description": "ভাষা নির্বাচন — বর্তমান UI থেকে নেওয়া দৃশ্যমান ধরন।",
      "html": "<div class=\"ds-language\" role=\"group\" aria-label=\"ভাষা\"><button aria-pressed=\"true\">বাংলা</button><button aria-pressed=\"false\">English</button></div>",
      "css": ".ds-language{display:inline-flex;gap:3px;padding:4px;background:#e9e2f3;border-radius:14px}.ds-language button{font-family:Baloo,Nunito,sans-serif;cursor:pointer;background:transparent;border:0;border-radius:10px;padding:7px 15px;min-height:40px;min-width:70px;font-size:14px;color:#675878}.ds-language button[aria-pressed=true]{background:white;color:#54348d;box-shadow:0 2px 6px #4230600d;font-weight:700}.ds-language button:focus-visible{outline:3px solid var(--purple,#7550ba);outline-offset:5px}"
    },
    {
      "name": "রঙের স্টিকার",
      "kind": "custom",
      "refersTo": "sticker",
      "description": "রঙের স্টিকার — বর্তমান UI থেকে নেওয়া দৃশ্যমান ধরন।",
      "html": "<button class=\"ds-sticker\" aria-label=\"নীল\"><span></span></button>",
      "css": ".ds-sticker{font-family:Baloo,Nunito,sans-serif;cursor:pointer;display:block;position:relative;width:140px;aspect-ratio:1;background:#3783E6;border:0;border-radius:26%;box-shadow:0 8px 16px #30284414;transform:rotate(4deg);transition:transform .35s cubic-bezier(.16,1,.3,1)}.ds-sticker span{position:absolute;left:15%;right:15%;top:12%;height:3px;background:#ffffff38;border-radius:100%}.ds-sticker:hover{transform:rotate(0) translateY(-5px) scale(1.025)}.ds-sticker:active{transform:rotate(0) scale(.94)}.ds-sticker:focus-visible{outline:3px solid var(--purple,#7550ba);outline-offset:5px}"
    },
    {
      "name": "পছন্দের radio",
      "kind": "input",
      "refersTo": "setting-option",
      "description": "পছন্দের radio — বর্তমান UI থেকে নেওয়া দৃশ্যমান ধরন।",
      "html": "<label class=\"ds-option\"><input type=\"radio\" name=\"ds-set\" checked><span>প্রথম ৪টি রং</span></label>",
      "css": ".ds-option{position:relative;display:block;width:180px;font-family:Baloo,Nunito,sans-serif;cursor:pointer}.ds-option input{position:absolute;opacity:0}.ds-option span{display:flex;align-items:center;justify-content:center;min-height:49px;border:1px solid #ded5e9;border-radius:12px;font-size:15px}.ds-option input:checked+span{background:#ede3fa;border-color:var(--purple,#7550ba);color:#5a3598}.ds-option input:focus-visible+span{outline:3px solid var(--purple,#7550ba);outline-offset:3px}"
