      "html": "<label class=\"ds-toggle\">কম অ্যানিমেশন <input type=\"checkbox\" checked></label>",
      "css": ".ds-toggle{display:flex;align-items:center;gap:15px;font-family:Baloo,Nunito,sans-serif;font-size:17px}.ds-toggle input{appearance:none;width:42px;height:25px;border-radius:20px;background:#d6cede;position:relative;cursor:pointer;transition:background .2s}.ds-toggle input:before{content:\"\";position:absolute;left:3px;top:3px;width:19px;height:19px;background:white;border-radius:50%;transition:transform .2s}.ds-toggle input:checked{background:var(--purple,#7550ba)}.ds-toggle input:checked:before{transform:translateX(17px)}.ds-toggle input:focus-visible{outline:3px solid var(--purple,#7550ba);outline-offset:5px}"
